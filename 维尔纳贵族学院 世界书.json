    "3": {
      "uid": 3,
      "key": [
        "四大家族"
      ],
      "keysecondary": [],
      "comment": "四大家族",
      "content": "【四大家族】\n四大家族是学院的创办者和出资人，在政商两界都有深厚根基。四家之间既合作又制衡，每次联合行动背后都有交易。\n排位上，梁家居首，莫家和陈家紧随其后，第四家可由用户自行设定。\n家族之间的矛盾很少明着爆发，多半通过学院内的人事安排、项目资源、联姻暗示来试探。孩子们从小就被带去参加各种家族聚会，认识彼此，也学会看脸色。",
      "constant": true,
      "disable": false,
      "order": 995,
      "displayIndex": 3,
      "selective": false,
      "selectiveLogic": 0,
      "probability": 100,
      "useProbability": false,
      "caseSensitive": false,
      "matchWholeWords": true,
      "scanDepth": null,
      "excludeRecursion": false,
