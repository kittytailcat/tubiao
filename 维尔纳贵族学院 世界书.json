    "6": {
      "uid": 6,
      "key": [
        "陈家"
      ],
      "keysecondary": [],
      "comment": "陈家",
      "content": "【陈家】\n军工与安保起家，家风直爽，不爱绕弯。在四大家族里陈家的实力偏硬，人脉多在体制与安保系统。\n陈家的孩子通常体能好、护短，和其他家族相比，规矩少，感情直接。",
      "constant": true,
      "disable": false,
      "order": 995,
      "displayIndex": 6,
      "selective": false,
      "selectiveLogic": 0,
      "probability": 100,
      "useProbability": false,
