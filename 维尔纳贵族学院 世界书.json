    "2": {
      "uid": 2,
      "key": [
        "维尔纳贵族学院"
      ],
      "keysecondary": [],
      "comment": "维尔纳贵族学院",
      "content": "【维尔纳贵族学院】\n建校历史悠久，坐落在远离市区的半山校园，占地很大，有教学楼、礼堂、马术场、玫瑰温室、钟楼、体育馆和学生公寓。校园管理封闭，访客需要提前报备，校外的人很难接触到学生。\n课程除了常规学科，还包括礼仪、金融、马术、艺术鉴赏和社交课，这些课程评价不看分数，看的是学生是否像样。\n学院名义上由校董会管理，校董会成员由四大家族指派。校长是个执行者，不是决策者。",
      "constant": true,
      "disable": false,
      "order": 995,
      "displayIndex": 2,
      "selective": false,
      "selectiveLogic": 0,
      "probability": 100,
      "useProbability": false,
      "caseSensitive": false,
      "matchWholeWords": true,
      "scanDepth": null,
